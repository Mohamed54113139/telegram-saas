# --- Base de données ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_saas?schema=public"

# --- Sécurité ---
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="change-moi-32-caracteres-minimum"

# --- IA (reformulation automatique des messages) ---
# Optionnel : si absent, la reformulation automatique est simplement ignorée (le message original est utilisé).
ANTHROPIC_API_KEY=""

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Intervalle (en secondes) entre deux cycles du scheduler
SCHEDULER_INTERVAL_SECONDS=30
