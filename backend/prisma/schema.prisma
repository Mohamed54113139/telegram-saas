// =========================================================================
// Schéma de base de données — Plateforme SaaS d'automatisation Telegram
// =========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------------
// UTILISATEURS
// -------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]

  @@map("users")
}

// -------------------------------------------------------------------------
// PROJETS
// -------------------------------------------------------------------------

enum Platform {
  TELEGRAM
}

model Project {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  platform  Platform @default(TELEGRAM)
  timezone  String   @default("UTC")

  // Réglages d'édition par défaut du projet (peuvent être surchargés par message)
  autoEditDefault       Boolean @default(false)
  editLevelDefault      EditLevel @default(NORMALE)
  similarityDefault     Int       @default(50) // 0 = très différent, 100 = très proche
  preserveEmojisDefault Boolean   @default(true)
  preservePunctuationDefault Boolean @default(false)
  signature             String?
  signatureEnabled      Boolean   @default(false)

  antiRepetitionEnabled Boolean @default(false)
  antiRepetitionWindow  Int     @default(10) // nb de publications récentes à comparer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  telegramChannel   TelegramChannel?
  messageTemplates  MessageTemplate[]
  protectedVariables ProtectedVariable[]
  messageVariables  MessageVariable[]
  schedules         Schedule[]
  sessions          Session[]
  scheduledPosts    ScheduledPost[]
  logs              Log[]
  contentSources    ContentSource[]
  digestItems       DigestItem[]
  instructionSuggestions InstructionSuggestion[]

  @@index([userId])
  @@map("projects")
}

// -------------------------------------------------------------------------
// CONNEXION TELEGRAM
// -------------------------------------------------------------------------

enum TelegramStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

model TelegramChannel {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Le token du bot n'est jamais renvoyé au frontend (voir routes/telegram.ts)
  botTokenEncrypted String
  chatId            String
  chatTitle         String?
  botUsername       String?

  status        TelegramStatus @default(DISCONNECTED)
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_channels")
}

// -------------------------------------------------------------------------
// MESSAGES MODÈLES
// -------------------------------------------------------------------------

enum EditLevel {
  LEGERE
  NORMALE
  IMPORTANTE
  PERSONNALISEE
}

model MessageTemplate {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name             String
  // Le contenu original n'est JAMAIS modifié automatiquement (Règle 1)
  originalContent  String
  imageUrl         String?

  // Présence simultanée = ce message est une copie d'un post Telegram existant ;
  // dans ce cas, originalContent/imageUrl/autoEdit/etc. sont ignorés à l'envoi
  sourceChatId     String?
  sourceMessageId  Int?

  autoEdit         Boolean   @default(false)
  editLevel        EditLevel @default(NORMALE)
  customInstructions String?
  similarity       Int       @default(50)

  preserveEmojis      Boolean @default(true)
  preservePunctuation Boolean @default(false)
  requiredElements    String[] @default([])

  signatureOverride     String?
  signatureEnabledOverride Boolean?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules      Schedule[]
  sessions       Session[]
  scheduledPosts ScheduledPost[]
  instructionSuggestions InstructionSuggestion[]

  @@index([projectId])
  @@map("message_templates")
}

// -------------------------------------------------------------------------
// VARIABLES
// -------------------------------------------------------------------------

// Variables non modifiables : doivent rester EXACTEMENT identiques (Règle 3)
model ProtectedVariable {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  value       String // le texte exact à protéger, ex: "ABC123" ou une URL
  label       String?
  isLink      Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("protected_variables")
}

enum VariableType {
  TEXT
  NUMBER
  DATE
  TIME
  DAY
}

// Variables modifiables : ex {NOM}, {VALEUR}, {DATE}...
model MessageVariable {
  id        String       @id @default(uuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key       String       // ex: "VALEUR" (utilisé dans le texte comme {VALEUR})
  type      VariableType @default(TEXT)

  // Pour type TEXT: liste de valeurs possibles (JSON stringifié côté appli, ou une seule valeur)
  possibleValues String[] @default([])

  // Pour type NUMBER
  numberMin         Float?
  numberMax         Float?
  preferredMin      Float?
  preferredMax      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
  @@map("message_variables")
}

// -------------------------------------------------------------------------
// PROGRAMMATION (messages ponctuels / récurrents, hors sessions)
// -------------------------------------------------------------------------

enum RepeatMode {
  ONCE
  DAILY
  CUSTOM_DAYS
  CUSTOM_DATES
}

model Schedule {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  messageTemplateId String
  messageTemplate   MessageTemplate @relation(fields: [messageTemplateId], references: [id], onDelete: Cascade)

  repeatMode RepeatMode @default(ONCE)
  daysOfWeek Int[]      @default([]) // 0=dimanche ... 6=samedi, utilisé si CUSTOM_DAYS
  specificDates DateTime[] @default([]) // utilisé si CUSTOM_DATES
  times      String[]   @default([]) // ex ["09:00","15:00"] heures locales au fuseau du projet

  startDate  DateTime?  // à partir de quelle date le schedule est actif
  endDate    DateTime?  // optionnel, fin de la récurrence

  active     Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledPosts ScheduledPost[]

  @@index([projectId])
  @@map("schedules")
}

// -------------------------------------------------------------------------
// SESSIONS DE PUBLICATION
// -------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name              String
  messageTemplateId String
  messageTemplate   MessageTemplate @relation(fields: [messageTemplateId], references: [id], onDelete: Cascade)

  startTime   DateTime // date+heure de début (UTC, calculée depuis le fuseau du projet)
  durationMin Int      // durée totale en minutes
  intervalMin Int      // intervalle entre publications en minutes

  // Message avant / après session (optionnels)
  beforeMessageTemplateId String?
  beforeMinutesOffset     Int?
  afterMessageTemplateId  String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledPosts ScheduledPost[]

  @@index([projectId])
  @@map("sessions")
}

// -------------------------------------------------------------------------
// PUBLICATIONS PROGRAMMÉES / HISTORIQUE (une seule table, filtrée par statut)
// -------------------------------------------------------------------------

enum PostStatus {
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

enum FeedbackType {
  POSITIVE
  NEGATIVE
}

model ScheduledPost {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  messageTemplateId String
  messageTemplate   MessageTemplate @relation(fields: [messageTemplateId], references: [id], onDelete: Cascade)

  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Identifiant unique métier pour dédupliquer (idempotency key) — voir point 50
  idempotencyKey String @unique

  scheduledFor DateTime // heure prévue (UTC)
  publishedAt  DateTime?

  // Contenu réellement envoyé (généré à partir du modèle) — snapshot, ne modifie jamais le modèle
  generatedContent String?
  variablesUsed    Json?

  status       PostStatus @default(SCHEDULED)
  attempts     Int        @default(0)
  lastError    String?

  isSimulation Boolean @default(false)
  feedback     FeedbackType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@map("scheduled_posts")
}

// -------------------------------------------------------------------------
// LOGS TECHNIQUES
// -------------------------------------------------------------------------

enum LogLevel {
  INFO
  WARN
  ERROR
}

model Log {
  id        String   @id @default(uuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  level     LogLevel @default(INFO)
  category  String   // ex: "telegram", "scheduler", "publication", "auth"
  message   String
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([category])
  @@map("logs")
}

// -------------------------------------------------------------------------
// SOURCES DE VEILLE (flux RSS surveillés automatiquement)
// -------------------------------------------------------------------------

enum ContentSourceMode {
  AUTO   // publie automatiquement chaque nouvel élément trouvé
  MANUAL // crée le message modèle sans le programmer, l'utilisateur décide
}

model ContentSource {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name    String
  feedUrl String
  mode    ContentSourceMode @default(MANUAL)
  // Mode digest quotidien : accumule le contenu trouvé au lieu de publier
  // individuellement chaque élément (voir DigestItem / {PRONOS_DU_JOUR})
  digestMode Boolean @default(false)

  active        Boolean   @default(true)
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seenItems ContentSourceItem[]

  @@index([projectId])
  @@map("content_sources")
}

// Historique des éléments déjà traités par une source, pour éviter les doublons
model ContentSourceItem {
  id              String        @id @default(uuid())
  contentSourceId String
  contentSource   ContentSource @relation(fields: [contentSourceId], references: [id], onDelete: Cascade)

  guid String // identifiant unique de l'élément dans le flux (guid, lien, ou titre à défaut)

  createdAt DateTime @default(now())

  @@unique([contentSourceId, guid])
  @@map("content_source_items")
}

// Éléments accumulés par une source en mode digest, en attente d'être
// consommés par la variable {PRONOS_DU_JOUR} au moment de la génération
model DigestItem {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentSourceId String
  title           String
  link            String?
  summary         String?
  consumed        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([projectId, consumed])
  @@map("digest_items")
}

// -------------------------------------------------------------------------
// SUGGESTIONS D'AMÉLIORATION DES INSTRUCTIONS (à partir des retours 👍/👎)
// -------------------------------------------------------------------------

model InstructionSuggestion {
  id                    String   @id @default(uuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messageTemplateId     String
  messageTemplate       MessageTemplate @relation(fields: [messageTemplateId], references: [id], onDelete: Cascade)

  currentInstructions   String?
  suggestedInstructions String
  reasoning             String

  status                String   @default("PENDING") // PENDING, APPROVED, REJECTED

  createdAt             DateTime @default(now())

  @@index([projectId, status])
  @@map("instruction_suggestions")
}
